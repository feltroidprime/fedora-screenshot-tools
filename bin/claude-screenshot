#!/bin/bash
# claude-screenshot - Capture d'écran → Claude Code ou envoi Tailscale
# Flux : Impr Ecran (capture normale) → Ctrl+Shift+Impr Ecran (action)
# Usage: claude-screenshot [--quick "prompt"] [--send DEVICE]

set -euo pipefail

export PATH="$HOME/.claude/local:$PATH"

DEFAULT_PROMPT="Extract all text from this image"
HOSTNAME=$(hostname)

# 1. Récupérer l'image depuis le presse-papiers
TMPFILE="/tmp/claude-screenshot-$$.png"

if ! wl-paste --type image/png > "$TMPFILE" 2>/dev/null || [[ ! -s "$TMPFILE" ]]; then
    rm -f "$TMPFILE"
    notify-send -i dialog-error "Claude Screenshot" "Pas d'image dans le presse-papiers.\nFais d'abord une capture avec Impr Écran."
    exit 0
fi

cleanup() { rm -f "$TMPFILE"; }
trap cleanup EXIT

# 2. Mode CLI direct
if [[ "${1:-}" == "--quick" ]]; then
    PROMPT="${2:-$DEFAULT_PROMPT}"
    # Aller directement à Claude
    notify-send -i dialog-information "Claude Screenshot" "Traitement en cours..."
    RESPONSE=$(echo "Read image '$TMPFILE'. Output ONLY raw text, no commentary. Task: $PROMPT" \
        | claude -p --model haiku --allowedTools "Read" --add-dir /tmp 2>&1) || true
    if [[ -n "$RESPONSE" ]]; then
        echo -n "$RESPONSE" | wl-copy
        zenity --text-info \
            --title="Claude Screenshot - Résultat (copié)" \
            --width=700 --height=500 --font="monospace" \
            <<< "$RESPONSE" 2>/dev/null || true
    else
        notify-send -i dialog-error "Claude Screenshot" "Pas de réponse"
    fi
    exit 0
fi

if [[ "${1:-}" == "--send" ]]; then
    DEVICE="${2:-macbook}"
    DEST="$DEVICE:~/Downloads/$HOSTNAME/"
    ssh "$DEVICE" "mkdir -p ~/Downloads/$HOSTNAME" && scp "$TMPFILE" "$DEST"
    if [[ $? -eq 0 ]]; then
        notify-send -i dialog-information "Claude Screenshot" "Envoyé à $DEVICE"
    else
        notify-send -i dialog-error "Claude Screenshot" "Échec envoi à $DEVICE"
    fi
    exit 0
fi

# 3. Dialog interactif : choisir l'action
# Lister les appareils Tailscale connectés
TAILSCALE_PEERS=$(tailscale status 2>/dev/null | grep -v "$HOSTNAME" | grep 'active' | awk '{print $2}' || true)

# Construire la liste zenity : Claude + chaque peer Tailscale
ZENITY_ITEMS=("claude" "Envoyer à Claude Code")
for PEER in $TAILSCALE_PEERS; do
    ZENITY_ITEMS+=("send:$PEER" "Envoyer à $PEER (~/Downloads/$HOSTNAME/)")
done

ACTION=$(zenity --list \
    --title="Claude Screenshot" \
    --text="Que faire avec cette capture ?" \
    --column="Action" --column="Description" \
    "${ZENITY_ITEMS[@]}" \
    --width=500 --height=400 \
    --hide-column=1 \
    2>/dev/null) || true

if [[ -z "$ACTION" ]]; then
    notify-send -i dialog-information "Claude Screenshot" "Annulé"
    exit 0
fi

# 4. Exécuter l'action
if [[ "$ACTION" == "claude" ]]; then
    # Demander le prompt
    PROMPT=$(zenity --entry \
        --title="Claude Screenshot" \
        --text="Prompt :" \
        --entry-text="$DEFAULT_PROMPT" \
        --width=500 2>/dev/null) || true

    PROMPT="${PROMPT:-$DEFAULT_PROMPT}"

    notify-send -i dialog-information "Claude Screenshot" "Traitement en cours..."

    RESPONSE=$(echo "Read image '$TMPFILE'. Output ONLY raw text, no commentary. Task: $PROMPT" \
        | claude -p --model haiku --allowedTools "Read" --add-dir /tmp 2>&1) || true

    if [[ -z "$RESPONSE" ]]; then
        notify-send -i dialog-error "Claude Screenshot" "Pas de réponse de Claude"
        exit 1
    fi

    echo -n "$RESPONSE" | wl-copy

    zenity --text-info \
        --title="Claude Screenshot - Résultat (copié)" \
        --width=700 --height=500 --font="monospace" \
        <<< "$RESPONSE" 2>/dev/null || true

elif [[ "$ACTION" == send:* ]]; then
    DEVICE="${ACTION#send:}"
    DEST="$DEVICE:~/Downloads/$HOSTNAME/"

    notify-send -i dialog-information "Claude Screenshot" "Envoi à $DEVICE..."

    ssh "$DEVICE" "mkdir -p ~/Downloads/$HOSTNAME" && scp "$TMPFILE" "$DEST"
    if [[ $? -eq 0 ]]; then
        notify-send -i dialog-information "Claude Screenshot" "Envoyé à $DEVICE :~/Downloads/$HOSTNAME/"
    else
        notify-send -i dialog-error "Claude Screenshot" "Échec envoi à $DEVICE"
    fi
fi
